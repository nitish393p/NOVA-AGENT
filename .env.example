# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# Firebase Admin service-account JSON used by the server to verify Firebase ID tokens
# and store memories under users/{uid}/memories. Keep this secret off the client.
FIREBASE_SERVICE_ACCOUNT_JSON=""

# Random 32-byte (64 hexadecimal character) secret used to encrypt per-account Gemini keys.
# Generate one with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
API_KEY_ENCRYPTION_SECRET=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"
